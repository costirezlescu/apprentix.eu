{
  "id": "regional-skills-ecosystems",
  "title": "Regional skills ecosystems (RESET)",
  "tagline": "How Europe's 244 regions compare on skills supply, demand, match and environment.",
  "description": "Cedefop's Regional skills ecosystem index (RESET) scores each EU NUTS 2 region from 1 to 100 on how skills are developed, used and supported, in four pillars and nine sub-pillars. Each record is one region with its overall score, its rank among all EU regions and within its country, and its scores on the VET-specific indicators (people with initial VET: job tasks, activity, employment, unemployment). Reference year 2024.",
  "recordLabel": {
    "one": "region",
    "many": "regions"
  },
  "source": {
    "name": "Cedefop — Regional skills ecosystem index (RESET)",
    "url": "https://www.cedefop.europa.eu/en/datasets/regional-skills-ecosystem-index",
    "licence": "CC BY 4.0. Licence CC BY 4.0 as declared for the dataset in Cedefop's data.europa.eu catalogue (the workbook states: Copyright Cedefop, 2026). Cite as: Cedefop (2026), Regional skills ecosystem index (RESET); compiled by Apprentix.",
    "licence_id": "CC-BY-4.0",
    "caveat": "Scores are standardised from 1 to 100 relative to the other EU regions (higher = more favourable); they are not raw statistics. Ranks and the 'position among EU regions' bands are calculated by Apprentix from the overall score. Version July 2026, reference year 2024. Cedefop's interactive tool: https://www.cedefop.europa.eu/en/tools/reset",
    "retrieved": "2026-10-16",
    "file_url": "https://www.cedefop.europa.eu/files/dataset-regional-skills-ecosystem-index-reset.xlsx",
