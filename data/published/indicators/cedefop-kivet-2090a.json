{
  "id": "cedefop-kivet-2090a",
  "title": "Employment premium for recent IVET graduates (over general stream) (%)",
  "description": "Premium expressed as a difference (in percentage points) between two indicators: the employment rate for recent IVET graduates and the corresponding employment rate for recent graduates (20-34 year-olds) from the general stream of education, i.e. at the same ISCED levels and who also graduated 1-3 years before the survey. Calculations exclude those still in (formal or non-formal) education and training (Cedefop calculations based on Eurostat data, LFS).",
  "unit": "%",
  "topic": "Skills development and labour market relevance",
  "source_label": "Cedefop Key indicators on VET, indicator 2090a",
  "comparability": "EU averages are Cedefop estimates (weighted averages of available country data) where flagged.",
  "flags": {
