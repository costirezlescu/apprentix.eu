  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2030.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-kivet-2030.html#dataset</dct:identifier><dct:title xml:lang="en">Enterprise expenditure on CVT courses as % of total labour cost</dct:title><dct:description xml:lang="en">Total monetary expenditure (TME) by enterprises on CVT courses as % of total labour cost (all enterprises). TME indicator excludes personnel absence costs (Cedefop calculations based on Eurostat data, CVTS). What is counted: EU averages are Cedefop estimates (weighted averages of available country data) where flagged.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2030.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-key-indicators-vet"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Expenditure</dcat:keyword><dcat:keyword>KIVET 2030</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/autho