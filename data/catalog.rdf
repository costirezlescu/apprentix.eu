  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-1051.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-kivet-1051.html#dataset</dct:identifier><dct:title xml:lang="en">Adults (25-64 year-olds) with a learning experience in the last 12 months (%) - AES (excl. GOJT)</dct:title><dct:description xml:lang="en">Percentage of the population aged 25-64 who participated in formal or non-formal education and training over the twelve months prior to the survey. (Eurostat, AES, data supplied at Cedefop request and excluding participation in guided on the job training; Cedefop uses these data for monitoring of the targets of the ESPR, the EEA and the Skills Agenda up until an evaluation of new LFS data on the topic becomes available). What is counted: EU averages are Cedefop estimates (weighted averages of available country data) where flagged.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-1051.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-key-indicators-vet"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Access, attractiveness and flexibility</dcat:keyword><dcat:keyword>KIVET 1051</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resourc