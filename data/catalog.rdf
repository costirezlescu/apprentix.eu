  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/vet-policy-timeline.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/vet-policy-timeline.html#dataset</dct:identifier><dct:title xml:lang="en">VET policy timeline</dct:title><dct:description xml:lang="en">National strategies, laws and practical measures on vocational education and training in the EU Member States, Iceland and Norway, reported annually by Cedefop's ReferNet network from 2015 to 2025. Filter to policies that concern apprenticeship and work-based learning.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/vet-policy-timeline.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop &amp; ReferNet — Timeline of VET policies in Europe (2025 update)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/timeline-EU-vet-policies"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dc