  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/vet-systems.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/vet-systems.html#dataset</dct:identifier><dct:title xml:lang="en">VET systems in Europe</dct:title><dct:description xml:lang="en">A guide to Cedefop's VET in Europe database: for each country, the latest detailed description of its vocational education and training system, written by the national ReferNet partner, with links to the full text, the 'Spotlight on VET' summary and the system chart. Apprentix links to these texts rather than copying them.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/vet-systems.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop &amp; ReferNet — VET in Europe database</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/tools/vet-in-europe"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.cedefop.europa.eu/en/tools/vet-in-europe"><rdfs:label>Cedefop's legal notice: reproduction is authorised provided the source is acknowledged, save where otherwise stated. Cite each description as given in its record.</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/datasets/vet-systems.html#json"><dct:title>VET systems in Europe (JSON records)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/datasets/vet-systems.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/vet-systems/records.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://www.cedefop.europa.eu/en/tools/vet-in-europe"><rdfs:label>Cedefop's legal notice: reproduction is authorised provided the source is acknowledged, save where otherwise stated. Cite each description as given in its record.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/vet-qualifications.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/vet-qualifications.html#dataset</dct:identifier><dct:title xml:lang="en">National VET qualifications in Europe</dct:title><dct:description xml:lang="en">Vocational qualifications that national qualification authorities publish to the Europass Qualifications Dataset Register (QDR), with their EQF and national framework levels, field of education, awarding body, credits and a short learning-outcome summary. Filter to qualifications obtained through apprenticeship or dual training. Each entry links to its official Europass record.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/vet-qualifications.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>European Commission, Europass — Qualifications Dataset Register (European Learning Data, SPARQL endpoint)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://data.europa.eu/data/datasets/european-learning-data?locale=en"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://eur-lex.europa.eu/eli/dec/2011/833/oj"><rdfs:label>European Commission reuse notice (Decision 2011/833/EU): reuse allowed with acknowledgement of the source. Data published to the QDR by national qualification authorities.</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/datasets/vet-qualifications.html#json"><dct:title>National VET qualifications in Europe (JSON records)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/datasets/vet-qualifications.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/vet-qualifications/records.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://eur-lex.europa.eu/eli/dec/2011/833/oj"><rdfs:label>European Commission reuse notice (Decision 2011/833/EU): reuse allowed with acknowledgement of the source. Data published to the QDR by national qualification authorities.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/regional-skills-ecosystems.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/regional-skills-ecosystems.html#dataset</dct:identifier><dct:title xml:lang="en">Regional skills ecosystems (RESET)</dct:title><dct:description xml:lang="en">Cedefop's Regional skills ecosystem index (RESET) scores each EU NUTS 2 region from 1 to 100 on how skills are developed, used and supported, in four pillars and nine sub-pillars. Each record is one region with its overall score, its rank among all EU regions and within its country, and its scores on the VET-specific indicators (people with initial VET: job tasks, activity, employment, unemployment). Reference year 2024.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/regional-skills-ecosystems.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop — Regional skills ecosystem index (RESET)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/regional-skills-ecosystem-index"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/datasets/regional-skills-ecosystems.html#json"><dct:title>Regional skills ecosystems (RESET) (JSON records)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/datasets/regional-skills-ecosystems.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/regional-skills-ecosystems/records.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-clssi.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-clssi.html#dataset</dct:identifier><dct:title xml:lang="en">Cedefop labour and skills shortage index (CLSSI) by occupation</dct:title><dct:description xml:lang="en">Cedefop's labour and skills shortage index for 38 occupation groups (ISCO-08 2-digit), by country. The index is the average of three component shortage indicators (LSI1, LSI2, LSI3 in the source), each scored from 1 to 4; higher values signal stronger labour and skills shortages in that occupation. Time is the release year of the dataset file (2026). What is counted: Scores are on an ordinal 1–4 scale; see the Cedefop dataset page for how the three component indicators are defined and banded. The workbook does not state the reference period of the underlying data (the dataset page dates from November 2024, the file from 2026). Where one component indicator is missing the index is the mean of the two available (flag 'm'). ISCO-08 codes were added by apprentix.eu from the occupation titles; occupation groups 63 and 95 are not covered. Cedefop's broad groups: High-skilled non-manual occupations: ISCO 11, 12, 13, 14, 21, 22, 23, 24, 25, 26, 31, 32, 33, 34, 35; Skilled non-manual occupations: ISCO 41, 42, 43, 44, 51, 52, 53, 54; Skilled manual occupations: ISCO 61, 62, 71, 72, 73, 74, 75, 81, 82, 83; Elementary Occupations: ISCO 91, 92, 93, 94, 96.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-clssi.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/labour-skills-shortage-index"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Skills intelligence</dcat:keyword><dcat:keyword>CLSSI 2026</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-clssi.html#csv"><dct:title>Cedefop labour and skills shortage index (CLSSI) by occupation (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-clssi.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-clssi.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-clssi.html#json"><dct:title>Cedefop labour and skills shortage index (CLSSI) by occupation (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-clssi.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-clssi.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-esi.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-esi.html#dataset</dct:identifier><dct:title xml:lang="en">European Skills Index (ESI), 2024 methodology</dct:title><dct:description xml:lang="en">Cedefop's European Skills Index measures how well each country's skills system performs, as a composite of 15 indicators grouped into three pillars — skills development (basic education; training and other education), skills activation (transition to work; labour market participation) and skills matching (skills utilisation; skills mismatch). Scores are normalised from 0 to 100, where 100 is the 'frontier' of best achievable performance. The ESI 2024 dataset recomputes every release from 2017 to 2024 with the 2024 methodology. Time is the ESI release year; the release year equals the data year plus 2 (e.g. ESI 2024 uses principally 2022 data). What is counted: All releases 2017–2024 in this series use the same (2024) methodology, so they are comparable over time and across countries. They are not comparable with the scores originally published in the ESI 2018, 2020 and 2022 editions (see cedefop-esi-editions). Indicator scores are normalised distances to the frontier, not raw values; the underlying raw data (before imputation) are in the source workbook's RawData sheet. No EU27 aggregate is published. Cedefop notes: Scores are the normalised scores from 0-100. The raw data is presented before any imputation. The release year is equal to the data year plus 2. So e.g. the ESI 2024 uses pricipally 2022 data. Blank cells denote missing values. For details on how the scores are constructed please consult our Technical Report.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-esi.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-european-skills-index-esi"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Skills intelligence</dcat:keyword><dcat:keyword>ESI 2024</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-esi.html#csv"><dct:title>European Skills Index (ESI), 2024 methodology (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-esi.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-esi.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-esi.html#json"><dct:title>European Skills Index (ESI), 2024 methodology (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-esi.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-esi.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-esi-editions.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-esi-editions.html#dataset</dct:identifier><dct:title xml:lang="en">European Skills Index (ESI) — 2018, 2020 and 2022 editions as published</dct:title><dct:description xml:lang="en">Overall index, pillar and sub-pillar scores of Cedefop's European Skills Index as published in the 2018, 2020 and 2022 editions. Each edition covers three data years (2018 edition: 2014–2016; 2020 edition: 2016–2018; 2022 edition: 2018–2020). Time is the data year, i.e. the year the underlying indicators refer to, not the release year. Scores are distances to the 'frontier' of best achievable performance, shown on a 0–100 scale. What is counted: Do not compare across editions: each edition re-estimated all years with its own methodology, indicator set and frontier, so the same country and data year has different scores in different editions. Within an edition, years and countries are comparable. Country coverage differs (2018: EU28; 2020 and 2022: EU27 + UK, CH, IS, NO). The 2018 overall index was published on a 0–100 scale and all other scores on a 0–1 scale; apprentix.eu multiplied the 0–1 scores by 100. The 2022 edition file gives scores rounded to two decimals. For a consistent time series use cedefop-esi (ESI 2024 dataset, releases 2017–2024). Cedefop notes: The year refers to the actual year that the indicators come from, rather than they year of release of the European Skills Index. For details on how the scores are constructed please consult our Technical Report.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-esi-editions.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-european-skills-index-esi"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Skills intelligence</dcat:keyword><dcat:keyword>ESI 2018/2020/2022</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2014</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-esi-editions.html#csv"><dct:title>European Skills Index (ESI) — 2018, 2020 and 2022 editions as published (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-esi-editions.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-esi-editions.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-esi-editions.html#json"><dct:title>European Skills Index (ESI) — 2018, 2020 and 2022 editions as published (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-esi-editions.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-esi-editions.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-1010.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-kivet-1010.html#dataset</dct:identifier><dct:title xml:lang="en">IVET students as % of all upper secondary students</dct:title><dct:description xml:lang="en">Number of students in upper secondary IVET (ISCED 3) as a percentage of all upper secondary students (Cedefop calculations based on Eurostat data, UOE data collection on formal education). What is counted: EU averages are Cedefop estimates (weighted averages of available country data) where flagged.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-1010.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-key-indicators-vet"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Access, attractiveness and flexibility</dcat:keyword><dcat:keyword>KIVET 1010</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/