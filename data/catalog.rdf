  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/financing-instruments.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/financing-instruments.html#dataset</dct:identifier><dct:title xml:lang="en">Financing apprenticeships: instruments</dct:title><dct:description xml:lang="en">The 55 financing instruments in Cedefop's database on financing apprenticeships in the EU: who pays, through which mechanism, for which costs, how much and for whom. Reference period 2016–17; the database has not been updated since.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/financing-instruments.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop — Database on financing apprenticeships in the EU</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/tools/financing-apprenticeships"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.cedefop.europa.eu/en/tools/financing-apprenticeships"><rdfs:label>Cedefop's legal notice: reproduction is authorised provided the source is acknowledged, save where otherwise stated.</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/datasets/financing-instruments.html#json"><dct:title>Financing apprenticeships: instruments (JSON records)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/datasets/financing-instruments.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/financing-instruments/records.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://www.cedefop.europa.eu/en/tools/financing-apprenticeships"><rdfs:label>Cedefop's legal notice: reproduction is authorised provided the source is acknowledged, save where otherwise stated.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/recognition-vet-qualifications.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/recognition-vet-qualifications.html#dataset</dct:identifier><dct:title xml:lang="en">Recognising foreign VET qualifications</dct:title><dct:description xml:lang="en">Cedefop's comparative mapping of national arrangements for recognising and validating foreign vocational qualifications and skills in the EU Member States, Iceland and Norway (Belgium's Flemish and French Communities separately). For each purpose — further learning, employment in regulated professions, employment in non-regulated professions — it names the information centre, the competent authority and the legal basis, and it summarises validation arrangements in the labour market. Situation at 1 June 2026.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/recognition-vet-qualifications.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop — Comparative mapping of national recognition and validation arrangements for foreign VET qualifications and skills. Dataset (2026)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/recognition-validation-VET-arrangements"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/datasets/recognition-vet-qualifications.html#json"><dct:title>Recognising foreign VET qualifications (JSON records)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/datasets/recognition-vet-qualifications.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/recognition-vet-qualifications/records.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/erasmus-vet-organisations.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/erasmus-vet-organisations.html#dataset</dct:identifier><dct:title xml:lang="en">Erasmus+ accredited VET organisations</dct:title><dct:description xml:lang="en">Schools, training centres, companies, chambers and public bodies awarded an Erasmus accreditation in VET (KA120-VET) in the 2021–2027 programme. Accredited organisations can send apprentices, learners and staff abroad every year without competing project by project. Each record shows where the organisation is, when it was accredited, and how many Erasmus+ VET mobility projects it has coordinated since 2021.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/erasmus-vet-organisations.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>European Commission — Erasmus+ projects lists for download (KA1 Learning Mobility of Individuals)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://erasmus-plus.ec.europa.eu/projects/projects-lists"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LIE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/datasets/erasmus-vet-organisations.html#json"><dct:title>Erasmus+ accredited VET organisations (JSON records)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/datasets/erasmus-vet-organisations.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/erasmus-vet-organisations/records.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/cove-projects.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/cove-projects.html#dataset</dct:identifier><dct:title xml:lang="en">Centres of Vocational Excellence projects</dct:title><dct:description xml:lang="en">Centres of Vocational Excellence (CoVEs) are Erasmus+ partnerships that bring together VET providers, employers, universities, chambers and public authorities from several countries around one sector or challenge. Each record is one CoVE project selected in the 2021–2025 calls, with its coordinator, partners and the countries involved.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/cove-projects.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>European Commission (DG EMPL) — Centres of Vocational Excellence: Project Participants data</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://employment-social-affairs.ec.europa.eu/policies-and-activities/skills-and-qualifications/skills-jobs/centres-vocational-excellence_en"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/datasets/cove-projects.html#json"><dct:title>Centres of Vocational Excellence projects (JSON records)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/datasets/cove-projects.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/cove-projects/records.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/nqf-qualification-levels.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/nqf-qualification-levels.html#dataset</dct:identifier><dct:title xml:lang="en">Qualification levels in national frameworks</dct:title><dct:description xml:lang="en">The level tables of Cedefop's NQF online tool (state of play 2024): each qualification type placed at a national framework level and, where the country has referenced its framework, at an EQF level. Filter to apprenticeship and craft qualifications to compare where they sit across Europe.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/nqf-qualification-levels.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop — National qualifications frameworks (NQF) online tool, 2024</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/tools/nqfs-online-tool"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ALB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BIH"/><dct:spatial rdf:resource="http://publications.eur