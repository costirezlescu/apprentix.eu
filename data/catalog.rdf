  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2065.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-kivet-2065.html#dataset</dct:identifier><dct:title xml:lang="en">Short cycle VET graduates as % of first time tertiary education graduates</dct:title><dct:description xml:lang="en">Short cycle tertiary VET graduates (ISCED 554) as a percentage of all graduates from first programmes at tertiary level of education (ISCED 544, 554; 645, 655, 665; 646, 656, 666; 746, 756, 766). Annual outflows (Cedefop calculations based on Eurostat data, UOE data collection on formal education) (a). What is counted: EU averages are Cedefop estimates (weighted averages of available country data) where flagged.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2065.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-key-indicators-vet"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Skills development and labour market relevance</dcat:keyword><dcat:keyword>KIVET 2065</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2065.html#csv"><dct:title>Short cycle VET graduates as % of first time tertiary education graduates (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2065.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-kivet-2065.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2065.html#json"><dct:title>Short cycle VET graduates as % of first time tertiary education graduates (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2065.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-kivet-2065.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2066.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-kivet-2066.html#dataset</dct:identifier><dct:title xml:lang="en">Recent IVET graduates (20-34 year-olds) with a work-based learning experience as part of their vocational education and training (%)</dct:title><dct:description xml:lang="en">Percentage of recent IVET graduates benefitting from exposure to work-based learning during their vocational education and training. Recent IVET graduates are considered those aged 20-34 who have graduated in the last 3 years before the survey and who have a medium-level vocational qualification (ISCED 3 or 4) as their highest educational attainment. Benefitting from exposure to work-based learning during IVET refers to having had work experience(s) undertaken as part of the curriculum of the formal programme leading to the highest education successfully completed. Work experiences are considered those with a duration of at least one month and occurred at a workplace in a market or non-market unit (i.e. in a company, government institution or non-profit organisation). Purely school-based work experiences are not considered (Eurostat, LFS). What is counted: EU averages are Cedefop estimates (weighted averages of available country data) where flagged.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2066.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-key-indicators-vet"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Skills development and labour market relevance</dcat:keyword><dcat:keyword>KIVET 2066</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2066.html#csv"><dct:title>Recent IVET graduates (20-34 year-olds) with a work-based learning experience as part of their vocational education and training (%) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2066.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-kivet-2066.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2066.html#json"><dct:title>Recent IVET graduates (20-34 year-olds) with a work-based learning experience as part of their vocational education and training (%) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2066.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-kivet-2066.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2080a.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-kivet-2080a.html#dataset</dct:identifier><dct:title xml:lang="en">Employment rate for recent IVET graduates (20-34 year-olds) (%)</dct:title><dct:description xml:lang="en">Employment rate of 20-34 year-olds who have obtained a medium level vocational qualification (ISCED 3 or 4) 1-3 years before the survey as their highest educational attainment and who are not in further (either formal or non-formal) education and training during the last four weeks prior to the survey (Eurostat, LFS). What is counted: EU averages are Cedefop estimates (weighted averages of available country data) where flagged.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2080a.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-key-indicators-vet"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Skills development and labour market relevance</dcat:keyword><dcat:keyword>KIVET 2080a</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MNE"/><dct:spatial rdf:resource="htt