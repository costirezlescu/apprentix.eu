ority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MNE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/UKR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/XKX"/><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.cedefop.europa.eu/en/tools/nqfs-online-tool"><rdfs:label>Cedefop's legal notice: reproduction is authorised provided the source is acknowledged, save where otherwise stated.</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/datasets/nqf-qualification-levels.html#json"><dct:title>Qualification levels in national frameworks (JSON records)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/datasets/nqf-qualification-levels.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/nqf-qualification-levels/records.json"/><dct:format rdf:resource="http: