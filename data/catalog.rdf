_BYSA_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-ev1524p-2t5-v.html#csv"><dct:title>Share of 15–24-year-olds enrolled in vocational education (UIS) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-ev1524p-2t5-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-ev1524p-2t5-v.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-ev1524p-2t5-v.html#json"><dct:title>Share of 15–24-year-olds enrolled in vocational education (UIS) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-ev1524p-2t5-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-ev1524p-2t5-v.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-2t3-v.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/uis-gtvp-2t3-v.html#dataset</dct:identifier><dct:title xml:lang="en">Share of secondary students in vocational programmes (UIS)</dct:title><dct:description xml:lang="en">Students enrolled in vocational programmes in lower and upper secondary education combined (ISCED 2–3) as a percentage of all secondary students, both sexes. What is counted: For EU, EFTA and OECD countries these figures come from the same joint UNESCO-OECD-Eurostat (UOE) collection as Eurostat's education statistics; UIS adds candidate countries. 'Vocational' includes school-based as well as work-based (apprenticeship-type) programmes, so this measures the weight of VET, not of apprenticeship. Includes lower secondary, so it is lower than the upper-secondary share and long series mix ISCED 1997 and ISCED 2011.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-2t3-v.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>UNESCO Institute for Statistics (UIS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://databrowser.uis.unesco.org/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>GTVP.2T3.V (data version 20260507-91260335)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ALB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BIH"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GEO"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LIE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MDA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MNE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/UKR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1971</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-2t3-v.html#csv"><dct:title>Share of secondary students in vocational programmes (UIS) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-2t3-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-gtvp-2t3-v.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-2t3-v.html#json"><dct:title>Share of secondary students in vocational programmes (UIS) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-2t3-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-gtvp-2t3-v.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-3-v.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/uis-gtvp-3-v.html#dataset</dct:identifier><dct:title xml:lang="en">Share of upper-secondary students in vocational programmes (UIS)</dct:title><dct:description xml:lang="en">Students enrolled in vocational programmes at upper-secondary level (ISCED 3) as a percentage of all upper-secondary students, both sexes. What is counted: For EU, EFTA and OECD countries these figures come from the same joint UNESCO-OECD-Eurostat (UOE) collection as Eurostat's education statistics; UIS adds candidate countries. 'Vocational' includes school-based as well as work-based (apprenticeship-type) programmes, so this measures the weight of VET, not of apprenticeship.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-3-v.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>UNESCO Institute for Statistics (UIS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://databrowser.uis.unesco.org/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>GTVP.3.V (data version 20260507-91260335)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ALB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/c