  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-3021.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-kivet-3021.html#dataset</dct:identifier><dct:title xml:lang="en">25-34 year-olds with tertiary attainment (%)</dct:title><dct:description xml:lang="en">Percentage of the population aged 25-34 who have successfully completed tertiary-level education. Tertiary education is defined as ISCED 5 and higher (Eurostat, LFS). What is counted: EU averages are Cedefop estimates (weighted averages of available country data) where flagged.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-3021.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-key-indicators-vet"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Education and employment context</dcat:keyword><dcat:keyword>KIVET 3021</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:res