//apprentix.eu/pages/indicators/cedefop-kivet-3090.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-kivet-3090.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-reset.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-reset.html#dataset</dct:identifier><dct:title xml:lang="en">Regional skills ecosystem index (RESET), country scores</dct:title><dct:description xml:lang="en">Cedefop's RESET compares how well skills are developed, used and supported, combining indicators in four pillars: skills supply, skills demand, skills match and the skills environment (quality of education and business environment, education–business cooperation). Several indicators look specifically at people with initial VET (IVET): the cognitive and digital content of their jobs, their activity, employment and unemployment. Scores run from 1 to 100; higher is more favourable. These are the country and EU-27 rows of the dataset; the 244 regional scores are in the 'Regional skills ecosystems' dataset. What is counted: Reference year 2024; one edition so far, so there is no time series. Scores are standardised (1–100) relative to the other EU regions, not raw values, and are designed to compare places with each other. RESET uses a different framework from Cedefop's European Skills Index (ESI); the two are not comparable. Covers EU member states only.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-reset.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/regional-skills-ecosystem-index"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Skills intelligence</dcat:keyword><dcat:keyword>RESET July 2026</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-reset.html#csv"><dct:title>Regional skills ecosystem index (RESET), country scores (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-reset.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-reset.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-reset.html#json"><dct:title>Regional skills ecosystem index (RESET), country scores (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-reset.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-reset.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-stas-employment.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-stas-employment.html#dataset</dct:identifier><dct:title xml:lang="en">Projected employment by occupation (STAS short-term projections)</dct:title><dct:description xml:lang="en">Cedefop's short-term projection of the number of people employed, by ISCO major occupation group (1-digit) and in total, for the current and next year. Release: Short-term Anticipation of Skills and VET demand (STAS) - August 2026 projections. What is counted: Short-term projections, not observations: STAS projects employment by occupation from EU-LFS quarterly and annual data and European job vacancy statistics, aligned to DG ECFIN's AMECO forecast of total employment growth (scenario 'Aligned_forecast_Ameco'). Updated twice a year, so values for the same year change between releases. Occupation titles in the 1-digit tables follow the source (ISCO major groups 1–9). EU27 is published by Cedefop. EU Member States only.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-stas-employment.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/stas"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Skills intelligence</dcat:keyword><dcat:keyword>STAS August 2026 (ameco_1d)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2027</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-stas-employment.html#csv"><dct:title>Projected employment by occupation (STAS short-term projections) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-stas-employment.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-stas-employment.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-stas-employment.html#json"><dct:title>Projected employment by occupation (STAS short-term projections) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-stas-employment.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-stas-employment.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-stas-employment-growth.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-stas-employment-growth.html#dataset</dct:identifier><dct:title xml:lang="en">Projected annual employment growth by occupation (STAS short-term projections)</dct:title><dct:description xml:lang="en">Cedefop's short-term projection of the annual growth rate of employment (percentage change on the previous year), by ISCO major occupation group (1-digit) and in total. Release: Short-term Anticipation of Skills and VET demand (STAS) - August 2026 projections. What is counted: Short-term projections, not observations: STAS projects employment by occupation from EU-LFS quarterly and annual data and European job vacancy statistics, aligned to DG ECFIN's AMECO forecast of total employment growth (scenario 'Aligned_forecast_Ameco'). Updated twice a year, so values for the same year change between releases. Occupation titles in the 1-digit tables follow the source (ISCO major groups 1–9). EU27 is published by Cedefop. EU Member States only. Growth rates are published as fractions and were multiplied by 100 by apprentix.eu.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-stas-employment-growth.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/stas"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Skills intelligence</dcat:keyword><dcat:keyword>STAS August 2026 (ameco_1d_%)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2027</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-stas-employment-growth.html#csv"><dct:title>Projected annual employment growth by occupation (STAS short-term projections) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-stas-employment-growth.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-stas-employment-growth.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/cedefop-stas-employment-growth.html#json"><dct:title>Projected annual employment growth by occupation (STAS short-term projections) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/cedefop-stas-employment-growth.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/cedefop-stas-employment-growth.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-entrants-vet.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/ch-bfs-entrants-vet.html#dataset</dct:identifier><dct:title xml:lang="en">Entrants to initial VET by training form (Switzerland)</dct:title><dct:description xml:lang="en">Number of people entering Swiss initial VET (new learners) in the calendar year, by training form (dual vs full-time school-based), qualification type and sex. What is counted: Source: BFS survey 'Berufliche Grundbildung (inkl. Qualifikationsverfahren)' (SBG-SFPI), calendar-year reference period, based on apprenticeship-contract and qualification-procedure records. A flow (entries in the year), not a stock; closest Swiss equivalent of 'new apprenticeship contracts' when the 'Dual' form is selected. National series: do not add to other countries' figures.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-entrants-vet.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Swiss Federal Statistical Office (BFS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://opendata.swiss/de/dataset/eintritte-nach-ausbildungsfeld-lehrbetriebskanton-ausbildungstyp-ausbildungsform-geschlecht-und1"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>px-x-1502020100_103</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2005</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-entrants-vet.html#csv"><dct:title>Entrants to initial VET by training form (Switzerland) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-entrants-vet.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-entrants-vet.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-entrants-vet.html#json"><dct:title>Entrants to initial VET by training form (Switzerland) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-entrants-vet.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-entrants-vet.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/ch-bfs-learners-vet.html#dataset</dct:identifier><dct:title xml:lang="en">Learners in initial VET (Switzerland)</dct:title><dct:description xml:lang="en">Number of learners enrolled in upper-secondary initial vocational education and training in Switzerland, by programme type (EFZ, EBA, non-regulated, commercial/IT schools, Anlehre) and sex. Time is the first calendar year of the school year (1999 = 1999/2000). What is counted: National series (BFS learners statistics, SDL; reference period = school year). Counts all learners in initial VET — both dual apprenticeships and full-time school-based programmes — so it is broader than an apprenticeship-contract count. The training-form split is in ch-bfs-learners-vet-form. Do not add to other countries' figures.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Swiss Federal Statistical Office (BFS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://opendata.swiss/de/dataset/sekundarstufe-ii-berufliche-grundbildung-lernende-nach-bildungstyp-ausbildungsfeld-geschlecht-u3"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>px-x-1502020100_104</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1999</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet.html#csv"><dct:title>Learners in initial VET (Switzerland) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-learners-vet.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet.html#json"><dct:title>Learners in initial VET (Switzerland) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-learners-vet.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-canton.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-canton.html#dataset</dct:identifier><dct:title xml:lang="en">Learners in initial VET by canton and training form (Switzerland)</dct:title><dct:description xml:lang="en">Total stock of learners in Swiss initial VET by canton of the training company (Lehrbetriebskanton) and training form (dual vs full-time school-based). 'CH' is the national total. What is counted: Source: BFS survey 'Berufliche Grundbildung (inkl. Qualifikationsverfahren)' (SBG-SFPI), calendar-year reference period, based on apprenticeship-contract and qualification-procedure records. Cantons are those of the training company (cantonal boundaries as at 1.1.2022). National series: do not add to other countries' figures.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-canton.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Swiss Federal Statistical Office (BFS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://opendata.swiss/de/dataset/gesamtbestand-der-lernenden-nach-ausbildungsfeld-lehrbetriebskanton-ausbildungstyp-ausbildungsf1"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>px-x-1502020100_203</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2005</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-canton.html#csv"><dct:title>Learners in initial VET by canton and training form (Switzerland) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-canton.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-learners-vet-canton.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-canton.html#json"><dct:title>Learners in initial VET by canton and training form (Switzerland) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-canton.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-learners-vet-canton.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-form.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-form.html#dataset</dct:identifier><dct:title xml:lang="en">Learners in initial VET by training form — dual vs school-based (Switzerland)</dct:title><dct:description xml:lang="en">Total stock of learners in Swiss initial VET (EFZ, EBA and non-regulated programmes), split into dual (training company + vocational school) and full-time school-based training, by qualification type and sex. What is counted: Source: BFS survey 'Berufliche Grundbildung (inkl. Qualifikationsverfahren)' (SBG-SFPI), calendar-year reference period, based on apprenticeship-contract and qualification-procedure records. Stock of learners during the calendar year, including full-time school-based programmes unless the 'Dual' training form is selected. The training form was not recorded in 2005–2006 (all learners appear as 'Not recorded'). Differs slightly from ch-bfs-learners-vet (different survey and reference period). National series: do not add to other countries' figures.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-form.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Swiss Federal Statistical Office (BFS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://opendata.swiss/de/dataset/gesamtbestand-der-lernenden-nach-ausbildungsfeld-lehrbetriebskanton-ausbildungstyp-ausbildungsf1"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>px-x-1502020100_203</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2005</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-form.html#csv"><dct:title>Learners in initial VET by training form — dual vs school-based (Switzerland) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-form.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-learners-vet-form.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-form.html#json"><dct:title>Learners in initial VET by training form — dual vs school-based (Switzerland) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-learners-vet-form.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-learners-vet-form.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-qualifications-vet.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/ch-bfs-qualifications-vet.html#dataset</dct:identifier><dct:title xml:lang="en">Initial VET qualifications awarded by training form (Switzerland)</dct:title><dct:description xml:lang="en">Number of initial VET qualifications awarded in Switzerland (Federal VET Diploma EFZ, Federal VET Certificate EBA, non-regulated), by training form (dual vs full-time school-based) and sex. What is counted: Source: BFS survey 'Berufliche Grundbildung (inkl. Qualifikationsverfahren)' (SBG-SFPI), calendar-year reference period, based on apprenticeship-contract and qualification-procedure records. Counts qualifications (successful qualification procedures) in the calendar year, not learners. National series: do not add to other countries' figures.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-qualifications-vet.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Swiss Federal Statistical Office (BFS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://opendata.swiss/de/dataset/abschlusse-nach-ausbildungsfeld-lehrbetriebskanton-ausbildungstyp-ausbildungsform-geschlecht-un1"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>px-x-1502020100_303</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2005</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-qualifications-vet.html#csv"><dct:title>Initial VET qualifications awarded by training form (Switzerland) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-qualifications-vet.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-qualifications-vet.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ch-bfs-qualifications-vet.html#json"><dct:title>Initial VET qualifications awarded by training form (Switzerland) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ch-bfs-qualifications-vet.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ch-bfs-qualifications-vet.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://opendata.swiss/en/terms-of-use#terms_by"><rdfs:label>opendata.swiss terms of use 'Open use. Must provide the source.' (terms_by): non-commercial and commercial use allowed; you must provide the source (author, title and link to the dataset). BFS: 'Freie Nutzung - Quellenangabe ist Pflicht'.</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/de-ba-applicants.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/de-ba-applicants.html#dataset</dct:identifier><dct:title xml:lang="en">Applicants for training places registered with the employment agencies (Germany)</dct:title><dct:description xml:lang="en">Young people who used the employment agencies' and job centres' placement service to look for a training place during the reporting year (October–September), by Land of residence. What is counted: National statistic (Germany), not comparable with other countries. Counts only what was registered with the employment agencies (Agenturen für Arbeit) and job centres for placement: registration is voluntary for employers and young people, so these are not all apprenticeship places or all applicants. Occupations recognised under the Vocational Training Act (BBiG, incl. the Crafts Code), i.e. mostly dual training. Time is the year in which the reporting year (1 October – 30 September) ends: 2025 = 2024/25; values are the reporting-year totals at 30 September. The most recent year may carry revised data. Source: © Statistik der Bundesagentur für Arbeit.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/de-ba-applicants.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistik der Bundesagentur für Arbeit</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://statistik.arbeitsagentur.de/DE/Navigation/Statistiken/Fachstatistiken/Ausbildungsmarkt/Ausbildungsmarkt-Nav.html"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>Ausbildungsmarkt, Zeitreihe (Produkt-ID 181)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-ba-applicants.html#csv"><dct:title>Applicants for training places registered with the employment agencies (Germany) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-ba-applicants.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-ba-applicants.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-ba-applicants.html#json"><dct:title>Applicants for training places registered with the employment agencies (Germany) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-ba-applicants.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-ba-applicants.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/de-ba-training-places.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/de-ba-training-places.html#dataset</dct:identifier><dct:title xml:lang="en">Training places registered with the employment agencies (Germany)</dct:title><dct:description xml:lang="en">Company training places (Berufsausbildungsstellen) that employers registered with the employment agencies and job centres for placement during the reporting year (October–September), by Land. What is counted: National statistic (Germany), not comparable with other countries. Counts only what was registered with the employment agencies (Agenturen für Arbeit) and job centres for placement: registration is voluntary for employers and young people, so these are not all apprenticeship places or all applicants. Occupations recognised under the Vocational Training Act (BBiG, incl. the Crafts Code), i.e. mostly dual training. Time is the year in which the reporting year (1 October – 30 September) ends: 2025 = 2024/25; values are the reporting-year totals at 30 September. The most recent year may carry revised data. Source: © Statistik der Bundesagentur für Arbeit.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/de-ba-training-places.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistik der Bundesagentur für Arbeit</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://statistik.arbeitsagentur.de/DE/Navigation/Statistiken/Fachstatistiken/Ausbildungsmarkt/Ausbildungsmarkt-Nav.html"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>Ausbildungsmarkt, Zeitreihe (Produkt-ID 181)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-ba-training-places.html#csv"><dct:title>Training places registered with the employment agencies (Germany) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-ba-training-places.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-ba-training-places.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-ba-training-places.html#json"><dct:title>Training places registered with the employment agencies (Germany) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-ba-training-places.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-ba-training-places.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/de-ba-unfilled-places.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/de-ba-unfilled-places.html#dataset</dct:identifier><dct:title xml:lang="en">Registered training places still unfilled at 30 September (Germany)</dct:title><dct:description xml:lang="en">Registered training places that were still vacant at the end of the reporting year (30 September), by Land: a measure of employers' difficulty in finding apprentices. What is counted: National statistic (Germany), not comparable with other countries. Counts only what was registered with the employment agencies (Agenturen für Arbeit) and job centres for placement: registration is voluntary for employers and young people, so these are not all apprenticeship places or all applicants. Occupations recognised under the Vocational Training Act (BBiG, incl. the Crafts Code), i.e. mostly dual training. Time is the year in which the reporting year (1 October – 30 September) ends: 2025 = 2024/25; values are the reporting-year totals at 30 September. The most recent year may carry revised data. Source: © Statistik der Bundesagentur für Arbeit. Unfilled = registered places with no apprentice at 30 September.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/de-ba-unfilled-places.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistik der Bundesagentur für Arbeit</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://statistik.arbeitsagentur.de/DE/Navigation/Statistiken/Fachstatistiken/Ausbildungsmarkt/Ausbildungsmarkt-Nav.html"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>Ausbildungsmarkt, Zeitreihe (Produkt-ID 181)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-ba-unfilled-places.html#csv"><dct:title>Registered training places still unfilled at 30 September (Germany) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-ba-unfilled-places.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-ba-unfilled-places.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-ba-unfilled-places.html#json"><dct:title>Registered training places still unfilled at 30 September (Germany) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-ba-unfilled-places.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-ba-unfilled-places.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/de-ba-unplaced-applicants.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/de-ba-unplaced-applicants.html#dataset</dct:identifier><dct:title xml:lang="en">Registered applicants still without a training place at 30 September (Germany)</dct:title><dct:description xml:lang="en">Registered applicants who at the end of the reporting year (30 September) had neither a training place nor an alternative (such as school, a course or a job) and were still looking, by Land. What is counted: National statistic (Germany), not comparable with other countries. Counts only what was registered with the employment agencies (Agenturen für Arbeit) and job centres for placement: registration is voluntary for employers and young people, so these are not all apprenticeship places or all applicants. Occupations recognised under the Vocational Training Act (BBiG, incl. the Crafts Code), i.e. mostly dual training. Time is the year in which the reporting year (1 October – 30 September) ends: 2025 = 2024/25; values are the reporting-year totals at 30 September. The most recent year may carry revised data. Source: © Statistik der Bundesagentur für Arbeit. Unplaced (unversorgt) excludes applicants with an alternative who still want a training place.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/de-ba-unplaced-applicants.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistik der Bundesagentur für Arbeit</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://statistik.arbeitsagentur.de/DE/Navigation/Statistiken/Fachstatistiken/Ausbildungsmarkt/Ausbildungsmarkt-Nav.html"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>Ausbildungsmarkt, Zeitreihe (Produkt-ID 181)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-ba-unplaced-applicants.html#csv"><dct:title>Registered applicants still without a training place at 30 September (Germany) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-ba-unplaced-applicants.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-ba-unplaced-applicants.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-ba-unplaced-applicants.html#json"><dct:title>Registered applicants still without a training place at 30 September (Germany) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-ba-unplaced-applicants.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-ba-unplaced-applicants.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://statistik.arbeitsagentur.de/DE/Home/Service/Impressum/impressum_node.html"><rdfs:label>Free reuse with source credit: '© Statistik der Bundesagentur für Arbeit' (BA statistics imprint: data and tables 'dürfen uneingeschränkt verwendet werden'; own calculations must be marked; values must not be altered)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/de-destatis-apprentices.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/de-destatis-apprentices.html#dataset</dct:identifier><dct:title xml:lang="en">Apprentices in dual vocational training (Germany)</dct:title><dct:description xml:lang="en">Number of apprentices (Auszubildende) in dual vocational training in Germany on 31 December, by sex and training area (Ausbildungsbereich: industry and trade, crafts, public service, agriculture, liberal professions, housekeeping, shipping). What is counted: National series from the Berufsbildungsstatistik (statistic 21211; reported by the competent bodies — chambers etc. — to the statistical offices). Covers dual vocational training under the Vocational Training Act (BBiG) and the Crafts Code (HwO) only; school-based VET (e.g. health and care schools, Berufsfachschulen) is not included. Stock on 31 December; counts training relationships (contracts), not persons. Do not add to other countries' figures.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-apprentices.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistisches Bundesamt (Destatis)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www-genesis.destatis.de/datenbank/online/table/21211-0001"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>21211-0001</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-destatis-apprentices.html#csv"><dct:title>Apprentices in dual vocational training (Germany) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-apprentices.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-destatis-apprentices.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-destatis-apprentices.html#json"><dct:title>Apprentices in dual vocational training (Germany) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-apprentices.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-destatis-apprentices.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/de-destatis-apprentices-land.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/de-destatis-apprentices-land.html#dataset</dct:identifier><dct:title xml:lang="en">Apprentices in dual vocational training by Land (Germany)</dct:title><dct:description xml:lang="en">Number of apprentices in dual vocational training on 31 December, by federal state (Land) of the training place and sex. 'DE' is the national total. What is counted: National series from the Berufsbildungsstatistik (statistic 21211; reported by the competent bodies — chambers etc. — to the statistical offices). Covers dual vocational training under the Vocational Training Act (BBiG) and the Crafts Code (HwO) only; school-based VET (e.g. health and care schools, Berufsfachschulen) is not included. Stock on 31 December, by Land. Do not add to other countries' figures.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-apprentices-land.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistisches Bundesamt (Destatis)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www-genesis.destatis.de/datenbank/online/table/21211-0101"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>21211-0101</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-destatis-apprentices-land.html#csv"><dct:title>Apprentices in dual vocational training by Land (Germany) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-apprentices-land.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-destatis-apprentices-land.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-destatis-apprentices-land.html#json"><dct:title>Apprentices in dual vocational training by Land (Germany) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-apprentices-land.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-destatis-apprentices-land.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/de-destatis-exams-passed.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/de-destatis-exams-passed.html#dataset</dct:identifier><dct:title xml:lang="en">Final apprenticeship examinations passed (Germany)</dct:title><dct:description xml:lang="en">Number of final examinations (Abschlussprüfungen) passed in dual vocational training in Germany during the calendar year, by sex and training area. What is counted: National series from the Berufsbildungsstatistik (statistic 21211; reported by the competent bodies — chambers etc. — to the statistical offices). Covers dual vocational training under the Vocational Training Act (BBiG) and the Crafts Code (HwO) only; school-based VET (e.g. health and care schools, Berufsfachschulen) is not included. Flow: passed examinations in the calendar year (including external candidates admitted without a training contract, as reported by Destatis). Do not add to other countries' figures.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-exams-passed.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistisches Bundesamt (Destatis)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www-genesis.destatis.de/datenbank/online/table/21211-0007"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>21211-0007</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-destatis-exams-passed.html#csv"><dct:title>Final apprenticeship examinations passed (Germany) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-exams-passed.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-destatis-exams-passed.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-destatis-exams-passed.html#json"><dct:title>Final apprenticeship examinations passed (Germany) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-exams-passed.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-destatis-exams-passed.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/de-destatis-new-contracts.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/de-destatis-new-contracts.html#dataset</dct:identifier><dct:title xml:lang="en">Newly concluded apprenticeship contracts (Germany)</dct:title><dct:description xml:lang="en">Number of newly concluded training contracts (neu abgeschlossene Ausbildungsverträge) in dual vocational training in Germany during the calendar year, by sex and training area. What is counted: National series from the Berufsbildungsstatistik (statistic 21211; reported by the competent bodies — chambers etc. — to the statistical offices). Covers dual vocational training under the Vocational Training Act (BBiG) and the Crafts Code (HwO) only; school-based VET (e.g. health and care schools, Berufsfachschulen) is not included. Flow: contracts concluded between 1 January and 31 December and still recorded by the competent body (Destatis count). BIBB's figure for new contracts (survey at 30 September, see de-bibb) uses a different reference period and is not identical. Do not add to other countries' figures.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-new-contracts.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistisches Bundesamt (Destatis)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www-genesis.destatis.de/datenbank/online/table/21211-0004"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>21211-0004</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-destatis-new-contracts.html#csv"><dct:title>Newly concluded apprenticeship contracts (Germany) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-new-contracts.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-destatis-new-contracts.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/de-destatis-new-contracts.html#json"><dct:title>Newly concluded apprenticeship contracts (Germany) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/de-destatis-new-contracts.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/de-destatis-new-contracts.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://www.govdata.de/dl-de/by-2-0"><rdfs:label>dl-de/by-2-0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html#dataset</dct:identifier><dct:title xml:lang="en">New training agreements in Danish vocational education (monthly)</dct:title><dct:description xml:lang="en">Number of new training agreements (indgåede uddannelsesaftaler) between vocational students and employers in Denmark each month, from the Ministry's Lærepladsstatistik. What is counted: Denmark, national source (STIL apprenticeship-place statistics). Flow: training agreements concluded in the month between a vocational (EUD) student and an approved company, covering all agreement types the ministry counts (ordinary, short, rest and combination agreements). Upper-secondary/post-secondary VET only (EUD; no higher-education apprenticeships). Not a count of apprentices in training (stock). The ministry discretionises small cells. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Børne- og Undervisningsministeriet / Styrelsen for IT og Læring (STIL), Uddannelsesstatistik.dk</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://uddannelsesstatistik.dk/Pages/Topics/22.aspx"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>EUD/PRAK/AFTALER</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2003</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html"><rdfs:label>CC BY 4.0 (as declared in the service's DCAT-AP-DK metadata); STIL terms of use require the credit 'Kilde: Uddannelsesstatistik.dk' and the retrieval date</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html#csv"><dct:title>New training agreements in Danish vocational education (monthly) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/dk-uvm-training-agreements.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html"><rdfs:label>CC BY 4.0 (as declared in the service's DCAT-AP-DK metadata); STIL terms of use require the credit 'Kilde: Uddannelsesstatistik.dk' and the retrieval date</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html#json"><dct:title>New training agreements in Danish vocational education (monthly) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/dk-uvm-training-agreements.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/dk-uvm-training-agreements.html"><rdfs:label>CC BY 4.0 (as declared in the service's DCAT-AP-DK metadata); STIL terms of use require the credit 'Kilde: Uddannelsesstatistik.dk' and the retrieval date</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/erasmus-cove-participations.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/erasmus-cove-participations.html#dataset</dct:identifier><dct:title xml:lang="en">Participations in Centres of Vocational Excellence projects</dct:title><dct:description xml:lang="en">Number of organisations from each country taking part in Erasmus+ Centres of Vocational Excellence (CoVE) projects, by call year and role (coordinator, partner, associated partner, affiliated entity). What is counted: Counts organisation-participations, not distinct organisations or projects: an organisation in two CoVEs counts twice. Only 13–16 CoVE projects are selected per call, so national figures are small and volatile. Associated partners and affiliated entities do not receive EU funding in the same way as full partners. Countries outside Europe are dropped. EU27 is the sum of member states.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/erasmus-cove-participations.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>European Commission (DG EMPL), Centres of Vocational Excellence</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://employment-social-affairs.ec.europa.eu/policies-and-activities/skills-and-qualifications/skills-jobs/centres-vocational-excellence_en"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Excellence</dcat:keyword><dcat:keyword>CoVE project participants 2021–2025</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ALB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BIH"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GEO"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MDA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/UKR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/XKX"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/erasmus-cove-participations.html#csv"><dct:title>Participations in Centres of Vocational Excellence projects (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/erasmus-cove-participations.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/erasmus-cove-participations.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/erasmus-cove-participations.html#json"><dct:title>Participations in Centres of Vocational Excellence projects (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/erasmus-cove-participations.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/erasmus-cove-participations.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-grant.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/erasmus-ka1-vet-grant.html#dataset</dct:identifier><dct:title xml:lang="en">EU grant for Erasmus+ VET mobility projects</dct:title><dct:description xml:lang="en">EU grant awarded to Erasmus+ Key Action 1 VET mobility projects, by country of the coordinating organisation and call year, in euros (current prices). What is counted: EU grant awarded after the selection stage, as published in the project lists; the Commission notes it is indicative and does not reflect changes made during or after the project. Counts Erasmus+ Key Action 1 VET mobility projects by the country of the coordinating (sending) organisation and call year, from the Commission's project lists. A project sends learners and staff abroad from that country; destination countries are not counted. The 2014–2020 actions (KA102, KA116) and 2021–2027 actions (KA121-VET, KA122-VET) are different instruments, so the break in 2021 is structural. Accredited (KA121) projects are multi-annual funding for accredited organisations, so a country with many accredited providers has few but large projects. ErasmusPro (long-term mobility of apprentices) is not a separate action and cannot be isolated. The participant count is not published in these files. All selected projects are counted whatever their current status (including terminated). Recent call years are incomplete until selection and contracting are finished. EU27 is the sum of the 27 member states (also for years before 2020, when the UK took part).</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-grant.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>European Commission (DG EAC / EACEA), Erasmus+ project results</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://erasmus-plus.ec.europa.eu/projects/projects-lists"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Mobility</dcat:keyword><dcat:keyword>ErasmusPlus_KA1</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LIE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2014</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-grant.html#csv"><dct:title>EU grant for Erasmus+ VET mobility projects (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-grant.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/erasmus-ka1-vet-grant.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-grant.html#json"><dct:title>EU grant for Erasmus+ VET mobility projects (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-grant.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/erasmus-ka1-vet-grant.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-projects.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/erasmus-ka1-vet-projects.html#dataset</dct:identifier><dct:title xml:lang="en">Erasmus+ VET mobility projects</dct:title><dct:description xml:lang="en">Number of Erasmus+ Key Action 1 mobility projects for vocational education and training learners and staff, by country of the coordinating organisation and call year. What is counted: Counts Erasmus+ Key Action 1 VET mobility projects by the country of the coordinating (sending) organisation and call year, from the Commission's project lists. A project sends learners and staff abroad from that country; destination countries are not counted. The 2014–2020 actions (KA102, KA116) and 2021–2027 actions (KA121-VET, KA122-VET) are different instruments, so the break in 2021 is structural. Accredited (KA121) projects are multi-annual funding for accredited organisations, so a country with many accredited providers has few but large projects. ErasmusPro (long-term mobility of apprentices) is not a separate action and cannot be isolated. The participant count is not published in these files. All selected projects are counted whatever their current status (including terminated). Recent call years are incomplete until selection and contracting are finished. EU27 is the sum of the 27 member states (also for years before 2020, when the UK took part).</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-projects.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>European Commission (DG EAC / EACEA), Erasmus+ project results</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://erasmus-plus.ec.europa.eu/projects/projects-lists"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Mobility</dcat:keyword><dcat:keyword>ErasmusPlus_KA1</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LIE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2014</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-projects.html#csv"><dct:title>Erasmus+ VET mobility projects (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-projects.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/erasmus-ka1-vet-projects.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-projects.html#json"><dct:title>Erasmus+ VET mobility projects (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/erasmus-ka1-vet-projects.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/erasmus-ka1-vet-projects.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/erasmus-vet-accreditations.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/erasmus-vet-accreditations.html#dataset</dct:identifier><dct:title xml:lang="en">New Erasmus accreditations in VET</dct:title><dct:description xml:lang="en">Number of organisations or consortia awarded an Erasmus accreditation in vocational education and training (KA120-VET), by country and call year. Accredited organisations can then apply each year for KA121-VET mobility funding. What is counted: Counts new accreditations granted in each call year; accreditations run until 2027, so this is a flow, not the stock of accredited providers. Includes consortium coordinators. No grant is attached to the accreditation itself. EU27 is the sum of member states.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/erasmus-vet-accreditations.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>European Commission (DG EAC / EACEA), Erasmus+ project results</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://erasmus-plus.ec.europa.eu/projects/projects-lists"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Mobility</dcat:keyword><dcat:keyword>ErasmusPlus_KA1 (KA120-VET)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LIE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/erasmus-vet-accreditations.html#csv"><dct:title>New Erasmus accreditations in VET (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/erasmus-vet-accreditations.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/erasmus-vet-accreditations.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/erasmus-vet-accreditations.html#json"><dct:title>New Erasmus accreditations in VET (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/erasmus-vet-accreditations.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/erasmus-vet-accreditations.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/eurostat-ed3sw-share-of-vet.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/eurostat-ed3sw-share-of-vet.html#dataset</dct:identifier><dct:title xml:lang="en">Share of upper-secondary VET pupils in work-based programmes</dct:title><dct:description xml:lang="en">Pupils in combined school- and work-based upper-secondary VET (ED3SW) as a percentage of all upper-secondary VET pupils (ED35). Calculated by Apprentix from Eurostat educ_uoe_enrs04; Cedefop publishes the same ratio as Key indicator 1020. What is counted: Inherits the caveats of the ED3SW category. Countries flagged 'm' have no work-based category in the UOE mapping.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/eurostat-ed3sw-share-of-vet.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Eurostat; calculation by Apprentix</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/educ_uoe_enrs04/default/table?lang=en"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>educ_uoe_enrs04</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LIE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MNE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2005</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/eurostat-ed3sw-share-of-vet.html#csv"><dct:title>Share of upper-secondary VET pupils in work-based programmes (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/eurostat-ed3sw-share-of-vet.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/eurostat-ed3sw-share-of-vet.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/eurostat-ed3sw-share-of-vet.html#json"><dct:title>Share of upper-secondary VET pupils in work-based programmes (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/eurostat-ed3sw-share-of-vet.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/eurostat-ed3sw-share-of-vet.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/eurostat-edat_lfse_24-general.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/eurostat-edat_lfse_24-general.html#dataset</dct:identifier><dct:title xml:lang="en">Employment rate of recent general-education graduates</dct:title><dct:description xml:lang="en">As the VET graduates' employment rate, but for 20–34-year-olds whose highest qualification is general (not vocational) upper-secondary or post-secondary (ISCED 34/44). Useful as a comparison. What is counted: From the EU Labour Force Survey.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/eurostat-edat_lfse_24-general.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Eurostat</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/edat_lfse_24/default/table?lang=en"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>edat_lfse_24</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BIH"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resour