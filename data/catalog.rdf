  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2034.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-kivet-2034.html#dataset</dct:identifier><dct:title xml:lang="en">Adults' average expenditure on non-formal learning (EUR per participant)</dct:title><dct:description xml:lang="en">Adults’ (25-64 year-olds') average expenditure on non-formal education and training activities over the 12 months prior to the survey. The average is estimated with respect to all amounts paid by participants.  Values are in Euros per person, without taking into account PPS or inflation (Eurostat, AES, estimates supplied at Cedefop request). What is counted: EU averages are Cedefop estimates (weighted averages of available country data) where flagged.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2034.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-key-indicators-vet"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Expenditure</dcat:keyword><dcat:keyword>KIVET 2034</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://pu