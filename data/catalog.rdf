  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/eurostat-edat_lfse_24-vet.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/eurostat-edat_lfse_24-vet.html#dataset</dct:identifier><dct:title xml:lang="en">Employment rate of recent VET graduates</dct:title><dct:description xml:lang="en">Employment rate of 20–34-year-olds, not in education or training, whose highest qualification is vocational upper-secondary or post-secondary (ISCED 35/45), obtained 1–3 years before the survey. What is counted: From the EU Labour Force Survey; same definition as the EU target indicator.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/eurostat-edat_lfse_24-vet.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Eurostat</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/edat_lfse_24/default/table?lang=en"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>edat_lfse_24</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BIH"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><d