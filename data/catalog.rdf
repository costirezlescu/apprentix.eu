ce="http://publications.europa.eu/resource/authority/country/SWE"/><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/datasets/vet-policy-timeline.html#json"><dct:title>VET policy timeline (JSON records)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/datasets/vet-policy-timeline.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/vet-policy-timeline/records.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/data-catalogue.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/data-catalogue.html#dataset</dct:identifier><dct:title xml:lang="en">Apprenticeship and VET open-data catalogue</dct:title><dct:description xml:lang="en">Datasets about apprenticeships, vocational education and training published by statistics offices, ministries, regions and cities, as listed on data.europa.eu. Each entry links to the original publisher; Apprentix does not host the data.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/data-catalogue.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>data.europa.eu — the official portal for European data (search API)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://data.europa.eu/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/