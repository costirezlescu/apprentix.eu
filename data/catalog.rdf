  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/cedefop-kivet-2025.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/cedefop-kivet-2025.html#dataset</dct:identifier><dct:title xml:lang="en">IVET public expenditure per student (1000 PPS units)</dct:title><dct:description xml:lang="en">Annual public expenditure (PPS) per student (FTE) in vocational upper secondary and post-secondary non-tertiary education (ISCED 3 and 4) in thousands of purchasing parity standard units (PPS) per student enrolled. The number of students enrolled used for the calculations is adjusted to the coverage of expenditure data and expressed in full-time equivalents (FTEs) (Eurostat, UOE data collection on formal education) (a). What is counted: EU averages are Cedefop estimates (weighted averages of available country data) where flagged.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/cedefop-kivet-2025.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/datasets/dataset-key-indicators-vet"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Expenditure</dcat:keyword><dcat:keyword>KIVET 2025</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications