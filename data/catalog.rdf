er-secondary students in vocational programmes (UIS) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-3-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-gtvp-3-v.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-3-v.html#json"><dct:title>Share of upper-secondary students in vocational programmes (UIS) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-3-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-gtvp-3-v.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-4-v.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/uis-gtvp-4-v.html#dataset</dct:identifier><dct:title xml:lang="en">Share of post-secondary non-tertiary students in vocational programmes (UIS)</dct:title><dct:description xml:lang="en">Students enrolled in vocational programmes at post-secondary non-tertiary level (ISCED 4) as a percentage of all students at that level, both sexes. What is counted: For EU, EFTA and OECD countries these figures come from the same joint UNESCO-OECD-Eurostat (UOE) collection as Eurostat's education statistics; UIS adds candidate countries. 'Vocational' includes school-based as well as work-based (apprenticeship-type) programmes, so this measures the weight of VET, not of apprenticeship. ISCED 4 is small or absent in some systems, so shares can swing between 0 and 100%.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-4-v.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>UNESCO Institute for Statistics (UIS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://databrowser.uis.unesco.org/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>GTVP.4.V (data version 20260507-91260335)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ALB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GEO"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LIE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MDA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MKD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/UKR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1998</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-4-v.html#csv"><dct:title>Share of post-secondary non-tertiary students in vocational programmes (UIS) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-4-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-gtvp-4-v.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-4-v.html#json"><dct:title>Share of post-secondary non-tertiary students in vocational programmes (UIS) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-4-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-gtvp-4-v.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-5-v.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/uis-gtvp-5-v.html#dataset</dct:identifier><dct:title xml:lang="en">Share of short-cycle tertiary students in vocational programmes (UIS)</dct:title><dct:description xml:lang="en">Students enrolled in vocational programmes at short-cycle tertiary level (ISCED 5) as a percentage of all short-cycle tertiary students, both sexes. What is counted: For EU, EFTA and OECD countries these figures come from the same joint UNESCO-OECD-Eurostat (UOE) collection as Eurostat's education statistics; UIS adds candidate countries. 'Vocational' includes school-based as well as work-based (apprenticeship-type) programmes, so this measures the weight of VET, not of apprenticeship. Many countries have no short-cycle tertiary level or report it only from 2011 (ISCED 2011).</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-5-v.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>UNESCO Institute for Statistics (UIS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://databrowser.uis.unesco.org/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>GTVP.5.V (data version 20260507-91260335)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ALB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BIH"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GEO"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MDA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/UKR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2013</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-5-v.html#csv"><dct:title>Share of short-cycle tertiary students in vocational programmes (UIS) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-5-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-gtvp-5-v.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-gtvp-5-v.html#json"><dct:title>Share of short-cycle tertiary students in vocational programmes (UIS) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-gtvp-5-v.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-gtvp-5-v.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/uis-xgdp-2t4-v-fsgov.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/uis-xgdp-2t4-v-fsgov.html#dataset</dct:identifier><dct:title xml:lang="en">Government expenditure on vocational secondary and post-secondary education (UIS)</dct:title><dct:description xml:lang="en">Government expenditure on vocational programmes in secondary and post-secondary non-tertiary education (ISCED 2–4) as a percentage of GDP. What is counted: Public spending only (all levels of government); excludes employer spending on apprentices' wages and in-company training, which is the larger share of apprenticeship cost in dual systems. Country coverage is patchy.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/uis-xgdp-2t4-v-fsgov.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>UNESCO Institute for Statistics (UIS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://databrowser.uis.unesco.org/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Expenditure</dcat:keyword><dcat:keyword>XGDP.2T4.V.FSGOV (data version 20260507-91260335)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BIH"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MDA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/MLT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2023</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-xgdp-2t4-v-fsgov.html#csv"><dct:title>Government expenditure on vocational secondary and post-secondary education (UIS) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-xgdp-2t4-v-fsgov.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-xgdp-2t4-v-fsgov.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uis-xgdp-2t4-v-fsgov.html#json"><dct:title>Government expenditure on vocational secondary and post-secondary education (UIS) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uis-xgdp-2t4-v-fsgov.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uis-xgdp-2t4-v-fsgov.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BYSA_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-achievements.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-achievements.html#dataset</dct:identifier><dct:title xml:lang="en">Apprenticeship achievements in England</dct:title><dct:description xml:lang="en">Number of apprenticeship programmes successfully completed (achieved) in England in each academic year, by apprenticeship level and age group. What is counted: Completions: programmes achieved in the academic year. England only (DfE Individualised Learner Record), not the whole United Kingdom: Scotland, Wales and Northern Ireland run separate apprenticeship systems and statistics. Time is the start year of the academic year (August–July), e.g. 2024 = 2024/25. All ages 16+. Levels: Intermediate = level 2 (EQF 3), Advanced = level 3 (EQF 4), Higher = levels 4–7 (EQF 5–7, including degree apprenticeships, i.e. higher-education apprenticeships). Figures rounded to the nearest 10 by DfE. The most recent academic year is provisional and covers only the part of the year reported to date (e.g. August–April) until the November release; it is flagged 'p' and must not be compared with full years. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-achievements.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Department for Education (England), Explore Education Statistics</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://explore-education-statistics.service.gov.uk/find-statistics/apprenticeships"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>1d419801-a90e-f970-9335-a13623faccbe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"><rdfs:label>OGL-UK-3.0</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-achievements.html#csv"><dct:title>Apprenticeship achievements in England (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-achievements.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uk-dfe-apprenticeship-achievements.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"><rdfs:label>OGL-UK-3.0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-achievements.html#json"><dct:title>Apprenticeship achievements in England (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-achievements.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uk-dfe-apprenticeship-achievements.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"><rdfs:label>OGL-UK-3.0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-participation.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-participation.html#dataset</dct:identifier><dct:title xml:lang="en">Apprenticeship participation in England</dct:title><dct:description xml:lang="en">Number of learners participating in an apprenticeship at any point during each academic year in England, by apprenticeship level and age group. What is counted: Participation: learners on an apprenticeship at any time in the academic year (not a point-in-time stock). DfE does not publish participation for every level × age combination. England only (DfE Individualised Learner Record), not the whole United Kingdom: Scotland, Wales and Northern Ireland run separate apprenticeship systems and statistics. Time is the start year of the academic year (August–July), e.g. 2024 = 2024/25. All ages 16+. Levels: Intermediate = level 2 (EQF 3), Advanced = level 3 (EQF 4), Higher = levels 4–7 (EQF 5–7, including degree apprenticeships, i.e. higher-education apprenticeships). Figures rounded to the nearest 10 by DfE. The most recent academic year is provisional and covers only the part of the year reported to date (e.g. August–April) until the November release; it is flagged 'p' and must not be compared with full years. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-participation.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Department for Education (England), Explore Education Statistics</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://explore-education-statistics.service.gov.uk/find-statistics/apprenticeships"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>1d419801-a90e-f970-9335-a13623faccbe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"><rdfs:label>OGL-UK-3.0</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-participation.html#csv"><dct:title>Apprenticeship participation in England (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-participation.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uk-dfe-apprenticeship-participation.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"><rdfs:label>OGL-UK-3.0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-participation.html#json"><dct:title>Apprenticeship participation in England (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-participation.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uk-dfe-apprenticeship-participation.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"><rdfs:label>OGL-UK-3.0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-starts.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-starts.html#dataset</dct:identifier><dct:title xml:lang="en">Apprenticeship starts in England</dct:title><dct:description xml:lang="en">Number of apprenticeship programmes started in England in each academic year, by apprenticeship level and age group. What is counted: Flow: programme starts (a learner starting two programmes counts twice). England only (DfE Individualised Learner Record), not the whole United Kingdom: Scotland, Wales and Northern Ireland run separate apprenticeship systems and statistics. Time is the start year of the academic year (August–July), e.g. 2024 = 2024/25. All ages 16+. Levels: Intermediate = level 2 (EQF 3), Advanced = level 3 (EQF 4), Higher = levels 4–7 (EQF 5–7, including degree apprenticeships, i.e. higher-education apprenticeships). Figures rounded to the nearest 10 by DfE. The most recent academic year is provisional and covers only the part of the year reported to date (e.g. August–April) until the November release; it is flagged 'p' and must not be compared with full years. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-starts.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Department for Education (England), Explore Education Statistics</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://explore-education-statistics.service.gov.uk/find-statistics/apprenticeships"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>1d419801-a90e-f970-9335-a13623faccbe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"><rdfs:label>OGL-UK-3.0</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-starts.html#csv"><dct:title>Apprenticeship starts in England (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-starts.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uk-dfe-apprenticeship-starts.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"><rdfs:label>OGL-UK-3.0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-starts.html#json"><dct:title>Apprenticeship starts in England (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/uk-dfe-apprenticeship-starts.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/uk-dfe-apprenticeship-starts.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/"><rdfs:label>OGL-UK-3.0</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
