  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/eurostat-trng_cvt_34s.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/eurostat-trng_cvt_34s.html#dataset</dct:identifier><dct:title xml:lang="en">Enterprises employing initial-VET participants</dct:title><dct:description xml:lang="en">Share of enterprises (10+ employees) that employed participants in initial vocational training (IVT) such as apprentices, by enterprise size. From the Continuing Vocational Training Survey (CVTS), every five years. What is counted: CVTS reference years 2005, 2010, 2015, 2020; the 2025 wave is expected around 2027.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/eurostat-trng_cvt_34s.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Eurostat</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/trng_cvt_34s/default/table?lang=en"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Employers</dcat:keyword><dcat:keyword>trng_cvt_34s</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/aut