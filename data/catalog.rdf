><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SRB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2005</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/eurostat-trng_cvt_34s.html#csv"><dct:title>Enterprises employing initial-VET participants (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/eurostat-trng_cvt_34s.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/eurostat-trng_cvt_34s.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/eurostat-trng_cvt_34s.html#json"><dct:title>Enterprises employing initial-VET participants (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/eurostat-trng_cvt_34s.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/eurostat-trng_cvt_34s.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-new-students.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-new-students.html#dataset</dct:identifier><dct:title xml:lang="en">New vocational students with apprenticeship periods in Finland</dct:title><dct:description xml:lang="en">Students who started vocational education in Finland during the calendar year and whose studies included apprenticeship training (oppisopimus) periods, by qualification type and sex. Totals are sums of Statistics Finland categories (calculated by Apprentix). What is counted: New students who started during the calendar year. Finland, national source (Statistics Finland, KOSKI register). Since the 2018 VET reform apprenticeship is a mode of acquiring competence inside a vocational qualification: counts here are people whose studies included at least one apprenticeship (oppisopimus, paid employment) period, possibly combined with school-based learning and training-agreement (koulutussopimus, unpaid) periods — not a count of apprenticeship contracts. Covers initial (upper-secondary), further and specialist vocational qualifications; many apprentices are adults taking further/specialist qualifications. No higher-education apprenticeships. Series starts in 2019. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-new-students.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistics Finland (Tilastokeskus)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://pxdata.stat.fi/PxWeb/pxweb/en/StatFin/StatFin__opiskt/14rw.px/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>14rw</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-new-students.html#csv"><dct:title>New vocational students with apprenticeship periods in Finland (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-new-students.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fi-statfin-apprenticeship-new-students.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-new-students.html#json"><dct:title>New vocational students with apprenticeship periods in Finland (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-new-students.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fi-statfin-apprenticeship-new-students.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-qualifications.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-qualifications.html#dataset</dct:identifier><dct:title xml:lang="en">Vocational qualifications with apprenticeship periods in Finland</dct:title><dct:description xml:lang="en">Vocational qualifications completed in Finland during the calendar year where the studies included apprenticeship training (oppisopimus) periods, by qualification type and sex. Totals are sums of Statistics Finland categories (calculated by Apprentix). What is counted: Qualifications completed during the calendar year (completions). Finland, national source (Statistics Finland, KOSKI register). Since the 2018 VET reform apprenticeship is a mode of acquiring competence inside a vocational qualification: counts here are people whose studies included at least one apprenticeship (oppisopimus, paid employment) period, possibly combined with school-based learning and training-agreement (koulutussopimus, unpaid) periods — not a count of apprenticeship contracts. Covers initial (upper-secondary), further and specialist vocational qualifications; many apprentices are adults taking further/specialist qualifications. No higher-education apprenticeships. Series starts in 2019. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-qualifications.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistics Finland (Tilastokeskus)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://pxdata.stat.fi/PxWeb/pxweb/en/StatFin/StatFin__opiskt/14rw.px/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>14rw</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-qualifications.html#csv"><dct:title>Vocational qualifications with apprenticeship periods in Finland (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-qualifications.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fi-statfin-apprenticeship-qualifications.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-qualifications.html#json"><dct:title>Vocational qualifications with apprenticeship periods in Finland (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-qualifications.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fi-statfin-apprenticeship-qualifications.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-students.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-students.html#dataset</dct:identifier><dct:title xml:lang="en">Vocational students with apprenticeship periods in Finland</dct:title><dct:description xml:lang="en">Students in Finnish vocational education during the calendar year whose studies included apprenticeship training (oppisopimus) periods, by qualification type and sex. Totals are sums of Statistics Finland categories (calculated by Apprentix). What is counted: Students who studied at any time during the calendar year (not a point-in-time stock). Finland, national source (Statistics Finland, KOSKI register). Since the 2018 VET reform apprenticeship is a mode of acquiring competence inside a vocational qualification: counts here are people whose studies included at least one apprenticeship (oppisopimus, paid employment) period, possibly combined with school-based learning and training-agreement (koulutussopimus, unpaid) periods — not a count of apprenticeship contracts. Covers initial (upper-secondary), further and specialist vocational qualifications; many apprentices are adults taking further/specialist qualifications. No higher-education apprenticeships. Series starts in 2019. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-students.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistics Finland (Tilastokeskus)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://pxdata.stat.fi/PxWeb/pxweb/en/StatFin/StatFin__opiskt/14rw.px/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>14rw</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2019</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-students.html#csv"><dct:title>Vocational students with apprenticeship periods in Finland (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-students.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fi-statfin-apprenticeship-students.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-students.html#json"><dct:title>Vocational students with apprenticeship periods in Finland (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fi-statfin-apprenticeship-students.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fi-statfin-apprenticeship-students.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html#dataset</dct:identifier><dct:title xml:lang="en">Apprentices under contract in France (end of month)</dct:title><dct:description xml:lang="en">Number of apprentices with a current apprenticeship contract on the last day of each month in France, by employer sector and level of the diploma prepared. What is counted: Stock: apprentices under contract on the last day of the month. DARES generally treats the last 48 months as provisional (flag 'p'). France, national source (DARES apprenticeship information system: Ari@ne and consular chambers 2013–2019, Deca from 2020, with DARES estimates for late reporting — using DSN for the most recent year). Covers ALL apprenticeship contracts, including the large and growing share preparing higher-education diplomas (Bac+2 to master/engineer, i.e. EQF 5–7), which most other countries' apprenticeship counts do not include. Geography: all French départements including the overseas DROM, excluding COM; employer establishment address. Raw data, not seasonally adjusted (strong September peak). The 'Scope' breakdown gives two alternative partitions of the total (by employer sector, and by level), so do not add sector and level values together. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>DARES (Ministère du Travail), POEM</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://poem.travail-emploi.gouv.fr/donnee/contrat-dapprentissage-secteurs-prive-et-public-stocks"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>new_cap_tot_stk</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2013</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html"><rdfs:label>unverified — POEM legal notice (mentions légales) states the site's contents are "des information publiques librement et gratuitement réutilisables dans les conditions fixées par la loi n°78-753 du 17 juillet 1978", but also asks reusers to contact dares.dsypef at travail.gouv.fr; no named open lice</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html#csv"><dct:title>Apprentices under contract in France (end of month) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fr-dares-apprentices-stock.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html"><rdfs:label>unverified — POEM legal notice (mentions légales) states the site's contents are "des information publiques librement et gratuitement réutilisables dans les conditions fixées par la loi n°78-753 du 17 juillet 1978", but also asks reusers to contact dares.dsypef at travail.gouv.fr; no named open lice</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html#json"><dct:title>Apprentices under contract in France (end of month) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fr-dares-apprentices-stock.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/fr-dares-apprentices-stock.html"><rdfs:label>unverified — POEM legal notice (mentions légales) states the site's contents are "des information publiques librement et gratuitement réutilisables dans les conditions fixées par la loi n°78-753 du 17 juillet 1978", but also asks reusers to contact dares.dsypef at travail.gouv.fr; no named open lice</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html#dataset</dct:identifier><dct:title xml:lang="en">New apprenticeship contracts in France (monthly)</dct:title><dct:description xml:lang="en">Number of new apprenticeship contracts starting each month in France (including renewals), by employer sector and level of the diploma prepared. What is counted: Flow: new contracts by contract start month, including renewals (reconduction). DARES treats the last 36 months as provisional (flag 'p'). France, national source (DARES apprenticeship information system: Ari@ne and consular chambers 2013–2019, Deca from 2020, with DARES estimates for late reporting — using DSN for the most recent year). Covers ALL apprenticeship contracts, including the large and growing share preparing higher-education diplomas (Bac+2 to master/engineer, i.e. EQF 5–7), which most other countries' apprenticeship counts do not include. Geography: all French départements including the overseas DROM, excluding COM; employer establishment address. Raw data, not seasonally adjusted (strong September peak). The 'Scope' breakdown gives two alternative partitions of the total (by employer sector, and by level), so do not add sector and level values together. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>DARES (Ministère du Travail), POEM</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://poem.travail-emploi.gouv.fr/donnee/contrat-dapprentissage-secteurs-prive-et-public-entrees"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>new_cap_tot_ent</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2013</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2026</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html"><rdfs:label>unverified — POEM legal notice (mentions légales) states the site's contents are "des information publiques librement et gratuitement réutilisables dans les conditions fixées par la loi n°78-753 du 17 juillet 1978", but also asks reusers to contact dares.dsypef at travail.gouv.fr; no named open lice</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html#csv"><dct:title>New apprenticeship contracts in France (monthly) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fr-dares-new-contracts.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html"><rdfs:label>unverified — POEM legal notice (mentions légales) states the site's contents are "des information publiques librement et gratuitement réutilisables dans les conditions fixées par la loi n°78-753 du 17 juillet 1978", but also asks reusers to contact dares.dsypef at travail.gouv.fr; no named open lice</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html#json"><dct:title>New apprenticeship contracts in France (monthly) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/fr-dares-new-contracts.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/fr-dares-new-contracts.html"><rdfs:label>unverified — POEM legal notice (mentions légales) states the site's contents are "des information publiques librement et gratuitement réutilisables dans les conditions fixées par la loi n°78-753 du 17 juillet 1978", but also asks reusers to contact dares.dsypef at travail.gouv.fr; no named open lice</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/ie-cso-apprentice-employment-rate.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/ie-cso-apprentice-employment-rate.html#dataset</dct:identifier><dct:title xml:lang="en">Qualified apprentices in employment in Ireland</dct:title><dct:description xml:lang="en">Share of apprentices who qualified in a given year who were in employment (with or without further education) a number of years after qualifying, by sex. Calculated by Apprentix from CSO counts: (employment only + employment and education) ÷ all qualified apprentices × 100. What is counted: Ireland, national source (CSO Apprenticeship Outcomes, from SOLAS apprenticeship records linked to CSO administrative data). Time is the year the apprentice qualified. Includes craft apprenticeships (NFQ level 6 Advanced Certificate) and the newer consortia-led apprenticeships (NFQ levels 5–8 in these tables), some of which are higher-education awards (NFQ 7–8, i.e. bachelor level). CSO rounds individual figures to the nearest five. Employment is derived from administrative (Revenue) records; the denominator includes apprentices whose outcome was 'not captured' (e.g. emigrated), and excludes records with missing or invalid PPSN. Rates are computed from counts rounded to the nearest five. Time is the qualification year; choose 'years since qualification' to compare cohorts at the same distance. Not comparable with survey-based (LFS) employment rates of VET graduates.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/ie-cso-apprentice-employment-rate.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Central Statistics Office (CSO), Ireland; calculation by Apprentix</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://data.cso.ie/table/AOQY13"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>AOQY13</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2010</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ie-cso-apprentice-employment-rate.html#csv"><dct:title>Qualified apprentices in employment in Ireland (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ie-cso-apprentice-employment-rate.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ie-cso-apprentice-employment-rate.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ie-cso-apprentice-employment-rate.html#json"><dct:title>Qualified apprentices in employment in Ireland (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ie-cso-apprentice-employment-rate.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ie-cso-apprentice-employment-rate.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/ie-cso-qualified-apprentices.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/ie-cso-qualified-apprentices.html#dataset</dct:identifier><dct:title xml:lang="en">Apprentices qualifying in Ireland</dct:title><dct:description xml:lang="en">Number of apprentices who qualified (completed their apprenticeship) in Ireland each year, by sex and National Framework of Qualifications (NFQ) level. What is counted: Ireland, national source (CSO Apprenticeship Outcomes, from SOLAS apprenticeship records linked to CSO administrative data). Time is the year the apprentice qualified. Includes craft apprenticeships (NFQ level 6 Advanced Certificate) and the newer consortia-led apprenticeships (NFQ levels 5–8 in these tables), some of which are higher-education awards (NFQ 7–8, i.e. bachelor level). CSO rounds individual figures to the nearest five. Completions (qualifications awarded), not registrations or stock; includes records with missing or invalid PPSN. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/ie-cso-qualified-apprentices.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Central Statistics Office (CSO), Ireland</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://data.cso.ie/table/AOQY02"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>AOQY02</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2010</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2020</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ie-cso-qualified-apprentices.html#csv"><dct:title>Apprentices qualifying in Ireland (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ie-cso-qualified-apprentices.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ie-cso-qualified-apprentices.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/ie-cso-qualified-apprentices.html#json"><dct:title>Apprentices qualifying in Ireland (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/ie-cso-qualified-apprentices.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/ie-cso-qualified-apprentices.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html#dataset</dct:identifier><dct:title xml:lang="en">BBL (work-based MBO) students in the Netherlands</dct:title><dct:description xml:lang="en">Students in the Dutch work-based MBO pathway (BBL) at 1 October, by MBO level and sector chamber (sectorkamer). What is counted: Netherlands, national source (DUO, 1-cijferbestand mbo from the ROD register). Stock: main enrolments (one per student per institution) at the reference date 1 October of the school year; time is the calendar year of that 1 October (e.g. 2025 = school year 2025/26). Includes funded and non-funded enrolments. The most recent year is provisional (flag 'p'). BBL is a learning pathway within MBO (levels 1–4, EQF 1–4), not a count of apprenticeship contracts; there is no higher-education apprenticeship in this count. DUO suppresses cells of 1–4 students (published as -1); these are excluded, so sums are lower bounds (by at most 4 × the number of suppressed cells). Do not sum with other countries. Summed from cells by sector chamber, level and province of residence, where suppression is more frequent than in the per-institution file: the all-levels/all-sectors total here is up to ~0.5% below the BBL value in nl-duo-mbo-students.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>DUO (Dienst Uitvoering Onderwijs), Open Onderwijsdata</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://onderwijsdata.duo.nl/dataset/mbo-studenten-per-sectorkamer-en-leerweg"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>mbo-studenten-per-sectorkamer-en-leerweg</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html"><rdfs:label>Creative Commons Attribution (as declared in the CKAN metadata, license_id 'cc-by'; version not stated)</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html#csv"><dct:title>BBL (work-based MBO) students in the Netherlands (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/nl-duo-bbl-students.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html"><rdfs:label>Creative Commons Attribution (as declared in the CKAN metadata, license_id 'cc-by'; version not stated)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html#json"><dct:title>BBL (work-based MBO) students in the Netherlands (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/nl-duo-bbl-students.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/nl-duo-bbl-students.html"><rdfs:label>Creative Commons Attribution (as declared in the CKAN metadata, license_id 'cc-by'; version not stated)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html#dataset</dct:identifier><dct:title xml:lang="en">MBO students in the Netherlands by learning pathway</dct:title><dct:description xml:lang="en">Students in Dutch secondary vocational education (MBO) at 1 October, by learning pathway: BBL (work-based, apprenticeship-type), BOL full-time and part-time (school-based), and exam-only participants. What is counted: Netherlands, national source (DUO, 1-cijferbestand mbo from the ROD register). Stock: main enrolments (one per student per institution) at the reference date 1 October of the school year; time is the calendar year of that 1 October (e.g. 2025 = school year 2025/26). Includes funded and non-funded enrolments. The most recent year is provisional (flag 'p'). BBL is a learning pathway within MBO (levels 1–4, EQF 1–4), not a count of apprenticeship contracts; there is no higher-education apprenticeship in this count. DUO suppresses cells of 1–4 students (published as -1); these are excluded, so sums are lower bounds (by at most 4 × the number of suppressed cells). Do not sum with other countries. Summed from per-institution counts; very few cells are suppressed in this file.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>DUO (Dienst Uitvoering Onderwijs), Open Onderwijsdata</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://onderwijsdata.duo.nl/dataset/mbo-studenten-per-instelling"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>mbo-studenten-per-instelling</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html"><rdfs:label>Creative Commons Attribution (as declared in the CKAN metadata, license_id 'cc-by'; version not stated)</rdfs:label></dct:LicenseDocument></dct:license><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html#csv"><dct:title>MBO students in the Netherlands by learning pathway (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/nl-duo-mbo-students.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html"><rdfs:label>Creative Commons Attribution (as declared in the CKAN metadata, license_id 'cc-by'; version not stated)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html#json"><dct:title>MBO students in the Netherlands by learning pathway (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/nl-duo-mbo-students.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license><dct:LicenseDocument rdf:about="https://apprentix.eu/pages/indicators/nl-duo-mbo-students.html"><rdfs:label>Creative Commons Attribution (as declared in the CKAN metadata, license_id 'cc-by'; version not stated)</rdfs:label></dct:LicenseDocument></dct:license></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/no-ssb-apprentices.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/no-ssb-apprentices.html#dataset</dct:identifier><dct:title xml:lang="en">Apprentices in Norway (1 October)</dct:title><dct:description xml:lang="en">Number of apprentices (lærlinger) in Norwegian upper secondary education at 1 October each year, by sex and age group; training candidates (lærekandidater) are available as a separate type. What is counted: Norway, national source (SSB table 08947). Stock of persons registered as apprentices (lærlinger) — and, in the 'type' breakdown, training candidates (lærekandidater, who sit a less comprehensive skills test instead of the full trade certificate) — in upper secondary education at 1 October of the year shown. SSB notes that apprentices include pupils in vocational training at school (Vg3) and trade certificate at work. Upper-secondary (EQF 4) apprenticeships only; there are no higher-education apprenticeships in this count. Not a count of contracts or starts; do not sum with other countries. Age is as at 31 December.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/no-ssb-apprentices.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistics Norway (SSB)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.ssb.no/en/statbank/table/08947"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>08947</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2006</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/no-ssb-apprentices.html#csv"><dct:title>Apprentices in Norway (1 October) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/no-ssb-apprentices.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/no-ssb-apprentices.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/no-ssb-apprentices.html#json"><dct:title>Apprentices in Norway (1 October) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/no-ssb-apprentices.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/no-ssb-apprentices.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/no-ssb-new-apprentices.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/no-ssb-new-apprentices.html#dataset</dct:identifier><dct:title xml:lang="en">New apprentices in Norway</dct:title><dct:description xml:lang="en">Number of new apprentices (nye lærlinger) in Norway per year, by age group. The all-ages total is the sum of SSB's age groups (calculated by Apprentix). What is counted: Norway, national source (SSB table 05376, whole country). SSB's 'New apprentices' category: apprentices registered as new in the year, counted in the 1 October upper-secondary statistics; training candidates (lærekandidater) are not included. Upper-secondary (EQF 4) apprenticeships only. Age as at 31 December. This is an entry/flow measure, not the stock of apprentices; do not sum with other countries or with the stock series.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/no-ssb-new-apprentices.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistics Norway (SSB)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.ssb.no/en/statbank/table/05376"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>05376</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2003</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/no-ssb-new-apprentices.html#csv"><dct:title>New apprentices in Norway (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/no-ssb-new-apprentices.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/no-ssb-new-apprentices.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/no-ssb-new-apprentices.html#json"><dct:title>New apprentices in Norway (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/no-ssb-new-apprentices.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/no-ssb-new-apprentices.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/no-ssb-trade-certificates.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/no-ssb-trade-certificates.html#dataset</dct:identifier><dct:title xml:lang="en">Trade and journeyman examinations taken in Norway</dct:title><dct:description xml:lang="en">Persons who completed a trade or journeyman's examination (fag-/svenneprøve) in Norway per school year, by type of training (apprentices, practice candidates, pupils) and result (all / passed). What is counted: Norway, national source (SSB table 09012). Completions: persons who sat the trade or journeyman's examination in the school year; time is the start year of the school year (e.g. 2024 = 2024/25). 'Apprentices' are candidates who trained under an apprenticeship contract; 'practice candidates' (praksiskandidater) qualify through work experience without a contract. Upper-secondary level only. Do not sum with other countries.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/no-ssb-trade-certificates.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Statistics Norway (SSB)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.ssb.no/en/statbank/table/09012"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>09012</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1998</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/no-ssb-trade-certificates.html#csv"><dct:title>Trade and journeyman examinations taken in Norway (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/no-ssb-trade-certificates.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/no-ssb-trade-certificates.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/no-ssb-trade-certificates.html#json"><dct:title>Trade and journeyman examinations taken in Norway (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/no-ssb-trade-certificates.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/no-ssb-trade-certificates.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/oecd-emp-rate-upper-secondary.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/oecd-emp-rate-upper-secondary.html#dataset</dct:identifier><dct:title xml:lang="en">Employment rate of adults with vocational vs general upper-secondary qualifications (OECD)</dct:title><dct:description xml:lang="en">Employment rate of adults whose highest qualification is upper-secondary or post-secondary non-tertiary, split into vocational (ISCED 35/45) and general (ISCED 34/44) orientation. From OECD Education at a Glance (labour-market outcomes, NEAC data collection). What is counted: Counts all adults in the age group (in or out of education) whose highest attainment is at this level, from national labour force surveys; it is not limited to recent graduates (unlike Eurostat's edat_lfse_24) and does not single out apprenticeship graduates. Some countries do not split by orientation; flag B marks series breaks and U low reliability.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/oecd-emp-rate-upper-secondary.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>OECD</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://data-explorer.oecd.org/vis?df[ds]=dsDisseminateFinalDMZ&amp;df[id]=DSD_EAG_LSO_EA@DF_LSO_NEAC_EMP&amp;df[ag]=OECD.EDU.IMEP"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Outcomes</dcat:keyword><dcat:keyword>OECD.EDU.IMEP:DSD_EAG_LSO_EA@DF_LSO_NEAC_EMP(1.0)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LTU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/PRT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/TUR"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2010</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2025</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-01</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/oecd-emp-rate-upper-secondary.html#csv"><dct:title>Employment rate of adults with vocational vs general upper-secondary qualifications (OECD) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/oecd-emp-rate-upper-secondary.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/oecd-emp-rate-upper-secondary.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/oecd-emp-rate-upper-secondary.html#json"><dct:title>Employment rate of adults with vocational vs general upper-secondary qualifications (OECD) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/oecd-emp-rate-upper-secondary.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/oecd-emp-rate-upper-secondary.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/oecd-share-vet-sw.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/oecd-share-vet-sw.html#dataset</dct:identifier><dct:title xml:lang="en">Share of VET students in combined school- and work-based programmes (OECD)</dct:title><dct:description xml:lang="en">Students enrolled in vocational programmes that combine school- and work-based learning (ISCED 35SW, 45SW, 55SW in the UOE data collection) as a percentage of all students in vocational programmes at the same ISCED level. From OECD Education at a Glance. What is counted: Same joint UNESCO-OECD-Eurostat (UOE) collection as Eurostat's educ_uoe_enrs tables, so for EU countries this mirrors the Eurostat-derived share; OECD adds non-EU members. 'School and work-based' is a programme classification made by each country (typically 10-25% or more of learning in the workplace), not a count of apprenticeship contracts; flag M means the category does not exist in the country's system.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/oecd-share-vet-sw.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>OECD</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://data-explorer.oecd.org/vis?df[ds]=dsDisseminateFinalDMZ&amp;df[id]=DSD_EAG_UOE_NON_FIN_STUD@DF_UOE_NF_SHARE_VET&amp;df[ag]=OECD.EDU.IMEP"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>OECD.EDU.IMEP:DSD_EAG_UOE_NON_FIN_STUD@DF_UOE_NF_SHARE_VET(1.1)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LUX"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LVA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NLD"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/NOR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/POL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ROU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SVK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/SWE"/><dct:temporal><dct:PeriodOfTime><dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2013</dcat:startDate><dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2024</dcat:endDate></dct:PeriodOfTime></dct:temporal><dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dct:modified><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/oecd-share-vet-sw.html#csv"><dct:title>Share of VET students in combined school- and work-based programmes (OECD) (CSV)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/oecd-share-vet-sw.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/oecd-share-vet-sw.csv"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/CSV"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/text/csv"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution><dcat:distribution><dcat:Distribution rdf:about="https://apprentix.eu/pages/indicators/oecd-share-vet-sw.html#json"><dct:title>Share of VET students in combined school- and work-based programmes (OECD) (JSON with provenance)</dct:title><dcat:accessURL rdf:resource="https://apprentix.eu/pages/indicators/oecd-share-vet-sw.html"/><dcat:downloadURL rdf:resource="https://apprentix.eu/data/published/indicators/oecd-share-vet-sw.json"/><dct:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/JSON"/><dcat:mediaType rdf:resource="https://www.iana.org/assignments/media-types/application/json"/><dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/></dcat:Distribution></dcat:distribution></dcat:Dataset></dcat:dataset>
  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/uis-ev1524p-2t5-v.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/uis-ev1524p-2t5-v.html#dataset</dct:identifier><dct:title xml:lang="en">Share of 15–24-year-olds enrolled in vocational education (UIS)</dct:title><dct:description xml:lang="en">Enrolment in vocational programmes (ISCED 2–5) of people aged 15–24 as a percentage of the population aged 15–24, both sexes. What is counted: For EU, EFTA and OECD countries these figures come from the same joint UNESCO-OECD-Eurostat (UOE) collection as Eurostat's education statistics; UIS adds candidate countries. 'Vocational' includes school-based as well as work-based (apprenticeship-type) programmes, so this measures the weight of VET, not of apprenticeship. The denominator is a population estimate (UN or Eurostat), so it reflects both VET popularity and how long young people stay in education.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/uis-ev1524p-2t5-v.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>UNESCO Institute for Statistics (UIS)</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://databrowser.uis.unesco.org/"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>EV1524P.2T5.V (data version 20260507-91260335)</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ALB"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BIH"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ESP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/EST"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FIN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/FRA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GBR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GEO"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/GRC"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HRV"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/HUN"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/IRL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ISL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/ITA"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/LIE"/><dct:spatial rdf:resource="http://publicat