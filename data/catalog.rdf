  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/datasets/apprenticeship-schemes.html#dataset"><dct:identifier>https://apprentix.eu/pages/datasets/apprenticeship-schemes.html#dataset</dct:identifier><dct:title xml:lang="en">Apprenticeship schemes in Europe</dct:title><dct:description xml:lang="en">Mainstream apprenticeship schemes with a stable legal basis in the EU Member States plus Iceland and Norway. Each record summarises one scheme and links to its official fiche.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/datasets/apprenticeship-schemes.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Cedefop — European database on apprenticeship schemes</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://www.cedefop.europa.eu/en/tools/apprenticeship-schemes"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BGR"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CYP"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DNK"/><dct:spati