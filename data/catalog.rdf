  <dcat:dataset><dcat:Dataset rdf:about="https://apprentix.eu/pages/indicators/eurostat-educ_uoe_enrs07-ed4sw.html#dataset"><dct:identifier>https://apprentix.eu/pages/indicators/eurostat-educ_uoe_enrs07-ed4sw.html#dataset</dct:identifier><dct:title xml:lang="en">Pupils in combined school- and work-based post-secondary VET</dct:title><dct:description xml:lang="en">Number of students in post-secondary non-tertiary vocational programmes combining school- and work-based learning (ISCED 4, 'SW' category). What is counted: As for the upper-secondary series: national programme mapping differs.</dct:description><dcat:landingPage rdf:resource="https://apprentix.eu/pages/indicators/eurostat-educ_uoe_enrs07-ed4sw.html"/><dct:publisher rdf:resource="https://apprentix.eu/#apprentix"/><dct:creator><foaf:Agent><foaf:name>Eurostat</foaf:name></foaf:Agent></dct:creator><dct:source rdf:resource="https://ec.europa.eu/eurostat/databrowser/view/educ_uoe_enrs07/default/table?lang=en"/><dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/><dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/><dcat:contactPoint rdf:resource="https://apprentix.eu/#contact"/><dcat:keyword>apprenticeship</dcat:keyword><dcat:keyword>vocational education and training</dcat:keyword><dcat:keyword>VET</dcat:keyword><dcat:keyword>work-based learning</dcat:keyword><dcat:keyword>Europe</dcat:keyword><dcat:keyword>Participation</dcat:keyword><dcat:keyword>educ_uoe_enrs07</dcat:keyword><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/AUT"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/BEL"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CHE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/CZE"/><dct:spatial rdf:resource="http://publications.europa.eu/resource/authority/country/DEU"/><dct:spatial rdf